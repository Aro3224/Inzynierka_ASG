@inject NavigationManager NavigationManager
@inject SearchState SearchState
@inject CartService CartService

<div class="container-fluid d-flex justify-content-end">
	<div class="col-4 d-flex justify-content-center gap-2">
		<input @bind="SearchText" type="text" placeholder="Wyszukaj..." />
		<button class="btn btn-primary" @onclick="Search">Szukaj</button>
	</div>
	<div class="col-4 d-flex justify-content-end align-items-center gap-2">
		<span class="d-flex justify-content-center align-items-center">@CartCost PLN</span>
		<button class="btn btn-success" @onclick="GoToCart">koszyk</button>
		@if (ItemsCount > 0)
		{
			<span>@ItemsCount</span>
		}
	</div>
</div>

@code {
	private string SearchText { get; set; } = string.Empty;

	private decimal CartCost;

	private int ItemsCount;

	private void Search()
	{
		if (SearchText != string.Empty)
		{
			SearchState.SetSearchQuery(SearchText);
			NavigationManager.NavigateTo($"/All?query={SearchText}");
		}
	}

	protected override void OnInitialized()
	{
		CartCost = CartService.GetTotalPrice();
		ItemsCount = CartService.GetTotalCount();
		CartService.CartChanged += UpdateCartData;
	}

	private void UpdateCartData()
	{
		CartCost = CartService.GetTotalPrice();
		ItemsCount = CartService.GetTotalCount();
		InvokeAsync(StateHasChanged);
	}

	private void GoToCart()
	{
		NavigationManager.NavigateTo($"/Cart/Products");
	}

	public void Dispose()
	{
		CartService.CartChanged -= UpdateCartData;
	}
}
