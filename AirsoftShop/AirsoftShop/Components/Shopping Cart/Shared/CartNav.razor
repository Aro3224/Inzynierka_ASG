<nav class="breadcrumb">
    @foreach (var step in Steps)
    {
        if (step.IsActive)
        {
            <span class="breadcrumb-item active">@step.Title</span>
        }
        else if (step.IsClickable)
        {
            <a href="@step.Link" class="breadcrumb-item">@step.Title</a>
        }
        else
        {
            <span class="breadcrumb-item active">@step.Title</span>
        }
    }
</nav>

@code {
    [Parameter]
    public required string ActiveStep { get; set; }

    private List<BreadcrumbStep> Steps { get; set; } = new();

    private HashSet<string> VisitedSteps { get; set; } = new();

    protected override void OnParametersSet()
    {
        VisitedSteps.Add(ActiveStep);

        Steps = new List<BreadcrumbStep>
        {
            new BreadcrumbStep("1. Produkty", "/Cart/Products"),
            new BreadcrumbStep("2. Dane zamawiającego", "/Cart/Order-Details"),
            new BreadcrumbStep("3. Dostawa i płatność", "/Cart/Shipping-Payment"),
            new BreadcrumbStep("4. Podsumowanie", "/Cart/Summary")
        };

        foreach (var step in Steps)
        {
            step.IsClickable = VisitedSteps.Contains(step.Link);

            if (step.Link == ActiveStep)
            {
                step.IsActive = true;
            }
        }
    }

    private class BreadcrumbStep
    {
        public string Title { get; }
        public string Link { get; }
        public bool IsActive { get; set; }
        public bool IsClickable { get; set; }

        public BreadcrumbStep(string title, string link)
        {
            Title = title;
            Link = link;
            IsActive = false;
            IsClickable = false;
        }
    }
}
