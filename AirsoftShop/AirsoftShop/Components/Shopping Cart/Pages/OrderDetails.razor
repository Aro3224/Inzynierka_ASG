@page "/Cart/Order-Details"
@using AirsoftShop.Components.Custom_Components

@inject NavigationManager Navigation
@inject IUserService UserService
@inject OrderDraftService OrderDraftService

<PageTitle>Koszyk - Dane zamawiającego</PageTitle>

<div class="container-fluid w-75">
	<div class="d-flex justify-content-end">
		<CartNav ActiveStep="/Cart/Order-Details" />
	</div>

	<div class="container-fluid w-50">
		<EditForm Model="@order" OnValidSubmit="@HandleValidSubmit" class="edit-form d-flex flex-column gap-3">
			<DataAnnotationsValidator />

			<div>
				<label for="name">Imię:</label>
				<InputText id="name" @bind-Value="order.CustomerName" class="form-control" />
				<ValidationMessage For="@(() => order.CustomerName)" />
			</div>

			<div>
				<label for="surname">Nazwisko:</label>
				<InputText id="surname" @bind-Value="order.CustomerSurname" class="form-control" />
				<ValidationMessage For="@(() => order.CustomerSurname)" />
			</div>

			<div>
				<label for="postalcode">Kod pocztowy:</label>
				<InputText id="postalcode" @bind-Value="order.PostalCode" class="form-control" />
				<ValidationMessage For="@(() => order.PostalCode)" />
			</div>

			<div>
				<label for="address">Miejscowość:</label>
				<InputText id="address" @bind-Value="order.City" class="form-control" />
				<ValidationMessage For="@(() => order.City)" />
			</div>

			<div>
				<label for="address">Adres:</label>
				<InputText id="address" @bind-Value="order.Address" class="form-control" />
				<ValidationMessage For="@(() => order.Address)" />
			</div>

			<div>
				<label for="phonenumber">Numer telefonu:</label>
				<InputText id="phonenumber" @bind-Value="order.PhoneNumber" class="form-control" />
				<ValidationMessage For="@(() => order.PhoneNumber)" />
			</div>

			<button type="submit" class="btn btn-outline-primary">Dalej</button>
		</EditForm>
	</div>
</div>
