@page "/Cart/Order-Details"
@using AirsoftShop.Components.Custom_Components

@inject NavigationManager Navigation
@inject IUserService UserService
@inject CartService CartService
@inject IOrderService OrderService

<PageTitle>Koszyk - Dane</PageTitle>

<div class="container-fluid w-75">
	<div class="d-flex justify-content-end">
		<CartNav ActiveStep="/Cart/Order-Details" />
	</div>

	<div class="container-fluid w-50">
		<EditForm Model="@order" OnValidSubmit="@HandleValidSubmit" class="edit-form">
			<DataAnnotationsValidator />

			<div>
				<label for="name">Imię:</label>
				<InputText id="name" @bind-Value="order.CustomerName" class="form-control" />
				<ValidationMessage For="@(() => order.CustomerName)" />
			</div>

			<div>
				<label for="surname">Nazwisko:</label>
				<InputText id="surname" @bind-Value="order.CustomerSurname" class="form-control" />
				<ValidationMessage For="@(() => order.CustomerSurname)" />
			</div>

			<div>
				<label for="postalcode">Kod pocztowy:</label>
				<InputText id="postalcode" @bind-Value="postalCode" @oninput="UpdateShippingAddress" class="form-control" />
				<ValidationMessage For="@(() => postalCode)" />
			</div>

			<div>
				<label for="address">Miejscowość:</label>
				<InputText id="address" @bind-Value="city" @oninput="UpdateShippingAddress" class="form-control" />
				<ValidationMessage For="@(() => city)" />
			</div>

			<div>
				<label for="address">Adres:</label>
				<InputText id="address" @bind-Value="address" @oninput="UpdateShippingAddress" class="form-control" />
				<ValidationMessage For="@(() => address)" />
			</div>

			<div>
				<label for="phonenumber">Numer telefonu:</label>
				<InputText id="phonenumber" @bind-Value="order.PhoneNumber" class="form-control" />
				<ValidationMessage For="@(() => order.PhoneNumber)" />
			</div>

			<div>
				<label for="manufacturer">Płatność:</label>
				<select @bind="order.PaymentMethod" class="form-select">
					<option value="" selected disabled>Wybierz...</option>
					@foreach (PaymentMethod paymentMethod in Enum.GetValues(typeof(PaymentMethod)))
					{
						<option value="@paymentMethod"><EnumDisplayName TEnum="PaymentMethod" Value="paymentMethod" /></option>
					}
				</select>
				<ValidationMessage For="@(() => order.PaymentMethod)" />
			</div>

			<div>
				<label for="description">Uwagi:</label>
				<InputTextArea id="description" @bind-value="order.CustomerComment" class="form-control" />
				<ValidationMessage For="@(() => order.CustomerComment)" />
			</div>

			<button type="submit" class="btn btn-secondary">Utwórz zamówienie</button>
		</EditForm>
	</div>
</div>
