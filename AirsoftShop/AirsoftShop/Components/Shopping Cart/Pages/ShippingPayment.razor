@page "/Cart/Shipping-Payment"
@using AirsoftShop.Components.Custom_Components

@inject NavigationManager Navigation
@inject OrderDraftService OrderDraftService

<PageTitle>Koszyk - Dostawa i płatność</PageTitle>

<div class="container-fluid w-75">
	<div class="d-flex justify-content-end">
		<CartNav ActiveStep="/Cart/Shipping-Payment" />
	</div>

	<div class="container-fluid w-50">
		<EditForm Model="@order" OnValidSubmit="@HandleValidSubmit" class="edit-form d-flex flex-column gap-3">
			<DataAnnotationsValidator />

			<div>
				<label for="manufacturer">Płatność:</label>
				<select @bind="order.PaymentMethod" class="form-select">
					<option value="" selected disabled>Wybierz...</option>
					@foreach (PaymentMethod paymentMethod in Enum.GetValues(typeof(PaymentMethod)))
					{
						<option value="@paymentMethod"><EnumDisplayName TEnum="PaymentMethod" Value="paymentMethod" /></option>
					}
				</select>
				<ValidationMessage For="@(() => order.PaymentMethod)" />
			</div>

			<div>
				<label for="courier">Kurier:</label>
				<select @bind="order.CourierCompany" class="form-select">
					<option value="" selected disabled>Wybierz...</option>
					@foreach (CourierCompany courierCompany in Enum.GetValues(typeof(CourierCompany)))
					{
						<option value="@courierCompany"><EnumDisplayName TEnum="CourierCompany" Value="courierCompany" /></option>
					}
				</select>
				<ValidationMessage For="@(() => order.CourierCompany)" />
			</div>

			<div>
				<label for="description">Uwagi dotyczące zamówienia:</label>
				<InputTextArea id="description" @bind-value="order.CustomerComment" class="form-control" />
				<ValidationMessage For="@(() => order.CustomerComment)" />
			</div>

			<button type="submit" class="btn btn-outline-primary">Dalej</button>
		</EditForm>
	</div>
</div>
