@page "/Product/{ProductType}/{Id}"
@using AirsoftShop.Data
@using AirsoftShop.Components.Custom_Components.ProductDetails_Navigation
@using System.ComponentModel.DataAnnotations

@inject IProductService ProductService

<PageTitle>Produkt - @(Product?.Name ?? "Wczytywanie...")</PageTitle>

<div class="container w-75">
	@if (Product is not null)
	{
		@switch (Product.ProductType)
		{
			case Data.ProductType.Replica:
				{
					var replica = Product as Replica;
					<ReplicaNavigation Replica="@replica" />
					break;
				}
			case Data.ProductType.Accessory:
				{
					var accessory = Product as Accessory;
					<AccessoryNavigation Accessory="@accessory" />
					break;
				}
			case Data.ProductType.Part:
				{
					var part = Product as Part;
					<PartNavigation Part="@part" />
					break;
				}
		}

		<div class="container-fluid d-flex flex-column gap-3">

			<div class="row d-flex flex-row">

				<div class="col-md-6 d-flex justify-content-center">
					<img src="" onerror="this.src='./Images/Replicas/icon01.png'" class="product-image w-75">
				</div>

				<div class="col-md-6 d-flex flex-column gap-4">
					<h2 class="fw-bold m-0">@Product.Name</h2>

					<h4 class="fw-bold m-0">@currentPrice zł</h4>

					<div class="d-flex flex-row align-items-center gap-2">
						<h5 class="m-0 fw-bold">Ilość</h5>
						<div class="border border-1 border-dark">
							<div class="m-1">
								<button class="counter-btn fw-bold" @onclick="DecreaseCounterValue">-</button>
								<input class="input-number" @bind="productCounter" @bind:after="UpdatePrice" />
								<button class="counter-btn fw-bold" @onclick="IncreaseCounterValue">+</button>
							</div>						
						</div>
					</div>

					<div>
						<button class="btn btn-success p-4">Dodaj do koszyka</button>
					</div>					
				</div>

			</div>

			<hr />

			<div>
				<h3>Opis</h3>

				<p>@Product.Description</p>
			</div>

			<div>
				<h3>Dane techniczne</h3>

				<table class="table">
					<tbody>
						@foreach (var property in Product.GetType().GetProperties())
						{
							if (excludedProperties.Contains(property.Name))
							{
								continue;
							}

							var value = property.GetValue(Product);

							var displayName = property.GetCustomAttributes(typeof(DisplayAttribute), false)
							.Cast<DisplayAttribute>()
							.FirstOrDefault()?.Name ?? property.Name;

							if (value is not null)
							{
								if (value.GetType().IsEnum)
								{
									if (value.GetType().GetCustomAttributes(typeof(FlagsAttribute), false).Any())
									{
										var flags = Enum.GetValues(value.GetType())
										.Cast<Enum>()
										.Where(flag => ((Enum)value).HasFlag(flag) && Convert.ToInt32(flag) != 0)
										.Select(flag => flag.GetType()
										.GetField(flag.ToString())
										?.GetCustomAttributes(typeof(DisplayAttribute), false)
										.Cast<DisplayAttribute>()
										.FirstOrDefault()?.Name ?? flag.ToString());

										value = string.Join(", ", flags);
									}
									else
									{
										value = value.GetType()
										.GetField(value.ToString())
										?.GetCustomAttributes(typeof(DisplayAttribute), false)
										.Cast<DisplayAttribute>()
										.FirstOrDefault()?.Name ?? value.ToString();
									}
								}
								else if (value is bool boolValue)
								{
									value = boolValue ? "Tak" : "Nie";
								}

								<tr>
									<td>@displayName</td>
									<td>@value</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>

		</div>
	}
	else
	{
		<h5>Wczytywanie...</h5>
	}
</div>