@page "/Accessories/{AccType?}"
@using AirsoftShop.Components.Menu.Custom_Components
@using AirsoftShop.Data
@using AirsoftShop.Enums

@inject IProductService ProductService
@inject SortingState SortingState
@inject NavigationManager NavigationManager

<PageTitle>AirsoftShop - Akcesoria</PageTitle>

<div class="col-md-3">
	<FiltersLayout ProductList="@AllAccessories" Category="@AccType" OnFilterChanged="HandleFilterChanged" />
</div>
<div class="col-md-9">
	<div class="container-fluid">
		<div class="row">
			@if (Accessories is null || !Accessories.Any())
			{
				<p>Brak wyników.</p>
			}
			else
			{
				@foreach (var accessory in Accessories)
				{
					<ItemProduct ImageSource="./Images/Accessories/icon03.png" Product="accessory" />
				}
			}
		</div>
	</div>
</div>
