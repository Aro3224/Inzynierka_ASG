@page "/Parts/{PType}/{DetPType?}"
@using AirsoftShop.Data
@using AirsoftShop.Components.Menu.Custom_Components
@using AirsoftShop.Enums

@inject IProductService ProductService
@inject SortingState SortingState
@inject NavigationManager NavigationManager

<PageTitle>AirsoftShop - Części</PageTitle>

<div class="col-md-3">
	<FiltersLayout ProductList="@AllParts" Category="@PType" DetPType="@DetPType" OnFilterChanged="HandleFilterChanged" />
</div>
<div class="col-md-9">
	<div class="container-fluid">
		<div class="container-fluid mb-2 px-0 fw-bold">
			<span>Ilość produktów: @Parts.Count</span>
		</div>
		<div class="row">
			@if (Parts is null || !Parts.Any())
			{
				<p>Brak wyników.</p>
			}
			else
			{
				@foreach (var part in Parts)
				{
					<ItemProduct ImageSource="./Images/Parts/icon02.png" Product="part" />
				}
			}
		</div>
	</div>
</div>
