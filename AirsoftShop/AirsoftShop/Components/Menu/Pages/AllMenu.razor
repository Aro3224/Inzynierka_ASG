@page "/All"
@using AirsoftShop.Components.Menu.Custom_Components
@using AirsoftShop.Data
@using AirsoftShop.Enums
@inject IProductService ProductService
@inject SearchState SearchState
@inject SortingState SortingState
@inject NavigationManager NavigationManager

<PageTitle>AirsoftShop - Wszystkie</PageTitle>

<div class="col-md-3">
	<FiltersLayout ProductList="@AllProducts" OnFilterChanged="HandleFilterChanged" />
</div>
<div class="col-md-9">
	<div class="container">
		<div class="container-fluid mb-2 px-0 fw-bold">
			<span>Ilość produktów: @FilteredProducts?.Count</span>
		</div>
		<div class="row">
			@if (FilteredProducts is null)
			{

			}
			else if (FilteredProducts.Any())
			{
				@foreach (var product in FilteredProducts)
				{
					<ItemProduct ImageSource="./Images/Replicas/sample_image.jpg" Product="product" />
				}
			}
			else
			{
				<p>Brak wyników wyszukiwania.</p>
			}
		</div>
	</div>
</div>
