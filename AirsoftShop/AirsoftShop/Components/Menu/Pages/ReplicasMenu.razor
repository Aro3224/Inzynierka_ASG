@page "/Replicas/{Category?}"
@using AirsoftShop.Data

@inject IProductService ProductService

<PageTitle>AirsoftShop - Repliki</PageTitle>

<div class="container-fluid">
	<div class="row">
		@foreach (var replica in Replicas)
		{
			<div class="col-md-3 product-card">
				<img src="./Images/Replicas/sample_image.jpg" alt="Product Image" class="product-image">
				<div class="product-info">
					<h5 class="product-name">@replica.Name</h5>
					<p class="product-price">@replica.Price.ToString()zł</p>
					<button type="button" class="btn btn-primary">Do koszyka</button>
				</div>
			</div>
		}
	</div>
</div>

@code {
	[Parameter]
	public string? Category { get; set; }

	private List<Replica> Replicas { get; set; } = new List<Replica>();

	protected override async Task OnParametersSetAsync()
	{
		var allProducts = await ProductService.GetAllProductsAsync();

		if (!string.IsNullOrEmpty(Category))
		{
			Replicas = allProducts.OfType<Replica>()
									.Where(r => r.WeaponCategory.ToString().Equals(Category, StringComparison.OrdinalIgnoreCase))
									.ToList();
		}
		else
		{
			Replicas = allProducts.OfType<Replica>().ToList();
		}
	}
}
