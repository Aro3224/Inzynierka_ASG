@page "/Replicas/{Category?}"
@using AirsoftShop.Components.Menu.Custom_Components
@using AirsoftShop.Data
@using AirsoftShop.Enums

@inject IProductService ProductService
@inject SortingState SortingState
@inject NavigationManager NavigationManager

<PageTitle>AirsoftShop - Repliki</PageTitle>

<div class="col-md-3">
	<FiltersLayout ProductList="@AllReplicas" Category="@Category" OnFilterChanged="HandleFilterChanged" />
</div>
<div class="col-md-9">
	<div class="container-fluid">
		<div class="row">
			@if (Replicas is null || !Replicas.Any())
			{
				<p>Brak wyników.</p>
			}
			else
			{
				@foreach (var replica in Replicas)
				{
					<ItemProduct ImageSource="./Images/Replicas/icon01.jpg" Product="replica" />
				}
			}
		</div>
	</div>
</div>
