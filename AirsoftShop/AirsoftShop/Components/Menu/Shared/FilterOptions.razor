@using AirsoftShop.Data
@typeparam T

<div>
    @switch (typeof(T).Name)
    {
        case nameof(Replica):
            <div>
                <label><input type="checkbox" @bind="FilterBySpring" /> Sprężynowa</label>
                <label><input type="checkbox" @bind="FilterByGas" /> Gazowa</label>
                <label><input type="checkbox" @bind="FilterByElectric" /> Elektryczna</label>
            </div>
            <button @onclick="ApplyFilters">Zastosuj filtry</button>
            break;

        case nameof(Accessory):
            <p>Akcesoria</p>
            break;

        case nameof(Part):
            <p>Części</p>
            break;
    }
</div>

@code {
    [Parameter]
    public IEnumerable<T> FilterOption { get; set; }

    [Parameter]
    public EventCallback<IEnumerable<T>> OnFilterChanged { get; set; }

    private bool FilterBySpring { get; set; } = false;
    private bool FilterByGas { get; set; } = false;
    private bool FilterByElectric { get; set; } = false;

    private async Task ApplyFilters()
    {
        IEnumerable<T> filtered = FilterOption;

        if (typeof(T) == typeof(Replica))
        {
            List<WeaponType> selectedWeaponTypes = new List<WeaponType>();

            if (FilterBySpring) selectedWeaponTypes.Add(WeaponType.Spring);
            if (FilterByGas) selectedWeaponTypes.Add(WeaponType.Gas);
            if (FilterByElectric) selectedWeaponTypes.Add(WeaponType.Electric);

            if (selectedWeaponTypes.Count == 0)
            {
                filtered = FilterOption.OfType<Replica>().Cast<T>();
            }
            else
            {
                filtered = FilterOption
                    .OfType<Replica>()
                    .Where(r => r.WeaponType.HasValue && selectedWeaponTypes.Contains(r.WeaponType.Value))
                    .Cast<T>();
            }
        }

        await OnFilterChanged.InvokeAsync(filtered);
    }
}
