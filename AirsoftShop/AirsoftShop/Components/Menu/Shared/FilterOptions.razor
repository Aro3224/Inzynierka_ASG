@using AirsoftShop.Components.Custom_Components
@using AirsoftShop.Data
@typeparam T


<div>
	<span>Marka:</span>
	@foreach (Manufacturer mType in Enum.GetValues(typeof(Manufacturer)))
	{
		<div>
			<input class="form-check-input"
				   type="checkbox"
				   value="@mType"
				   checked="@SelectedManufacturers.Contains(mType)"
				   @onchange="(e) => ToggleType(mType, (bool)e.Value, SelectedManufacturers)" />
			<label>
				<EnumDisplayName TEnum="Manufacturer" Value="mType" />
			</label>
		</div>
	}
</div>

<div>
	<span>Przedział cenowy (PLN):</span>
	<div class="d-flex flex-column gap-2">
		<div class="d-flex flex-row align-items-center gap-2">
			<span>Min: </span>
			<input class="input-group form-control" type="number" placeholder="Min" @bind="MinPrice" />
		</div>
		<div class="d-flex flex-row align-items-center gap-2">
			<span>Max: </span>
			<input class="input-group form-control" type="number" placeholder="Max" @bind="MaxPrice" />
		</div>
	</div>
</div>

@switch (typeof(T).Name)
{
	case nameof(Replica):
		{
			<div>
				<span>Napęd broni:</span>
				@foreach (WeaponType wType in Enum.GetValues(typeof(WeaponType)))
				{
					<div>
						<input class="form-check-input"
							   type="checkbox"
							   value="@wType"
							   checked="@SelectedWeaponTypes.Contains(wType)"
							   @onchange="(e) => ToggleType(wType, (bool)e.Value, SelectedWeaponTypes)" />
						<label>
							<EnumDisplayName TEnum="WeaponType" Value="wType" />
						</label>
					</div>
				}
			</div>

			<div>
				<span>Typ gearboxa:</span>
				@foreach (GearboxType gType in Enum.GetValues(typeof(GearboxType)))
				{
					<div>
						<input class="form-check-input"
							   type="checkbox"
							   value="@gType"
							   checked="@SelectedGearboxTypes.Contains(gType)"
							   @onchange="(e) => ToggleType(gType, (bool)e.Value, SelectedGearboxTypes)" />
						<label>
							<EnumDisplayName TEnum="GearboxType" Value="gType" />
						</label>
					</div>
				}
			</div>

			<div>
				<span>Epoka broni:</span>
				@foreach (WeaponAge wAge in Enum.GetValues(typeof(WeaponAge)))
				{
					<div>
						<input class="form-check-input"
							   type="checkbox"
							   value="@wAge"
							   checked="@SelectedWeaponAges.Contains(wAge)"
							   @onchange="(e) => ToggleType(wAge, (bool)e.Value, SelectedWeaponAges)" />
						<label>
							<EnumDisplayName TEnum="WeaponAge" Value="wAge" />
						</label>
					</div>
				}
			</div>

			<div>
				<span>Akumulator w zestawie?</span>
				<div>
					<input class="form-check-input" type="checkbox" id="batteryYes" checked="@HasBatteryTrue" @onchange='(e) => ToggleBoolean("battery",true, (bool)e.Value)' />
					<label for="batteryYes">Tak</label>
				</div>
				<div>
					<input class="form-check-input" type="checkbox" id="batteryNo" checked="@HasBatteryFalse" @onchange='(e) => ToggleBoolean("battery",false, (bool)e.Value)' />
					<label for="batteryNo">Nie</label>
				</div>
			</div>

			<div>
				<span>Hop-Up?</span>
				<div>
					<input class="form-check-input" type="checkbox" id="batteryYes" checked="@HasHopUpTrue" @onchange='(e) => ToggleBoolean("hopUp",true, (bool)e.Value)' />
					<label for="batteryYes">Tak</label>
				</div>
				<div>
					<input class="form-check-input" type="checkbox" id="batteryNo" checked="@HasHopUpFalse" @onchange='(e) => ToggleBoolean("hopUp",false, (bool)e.Value)' />
					<label for="batteryNo">Nie</label>
				</div>
			</div>

			<div>
				<span>Blow-Back?</span>
				<div>
					<input class="form-check-input" type="checkbox" id="batteryYes" checked="@HasBlowBackTrue" @onchange='(e) => ToggleBoolean("blowBack",true, (bool)e.Value)' />
					<label for="batteryYes">Tak</label>
				</div>
				<div>
					<input class="form-check-input" type="checkbox" id="batteryNo" checked="@HasBlowBackFalse" @onchange='(e) => ToggleBoolean("blowBack",false, (bool)e.Value)' />
					<label for="batteryNo">Nie</label>
				</div>
			</div>

			break;
		}
	case nameof(Accessory):
		{
			if (Enum.TryParse<AccessoryType>(Category, true, out var accessoryType))
			{
				switch (accessoryType)
				{
					case AccessoryType.Bbs:
						{
							<div>
								<span>Typ kulki:</span>
								@foreach (BbType bbType in Enum.GetValues(typeof(BbType)))
								{
									<div>
										<input class="form-check-input"
											   type="checkbox"
											   value="@bbType"
											   checked="@SelectedBbTypes.Contains(bbType)"
											   @onchange="(e) => ToggleType(bbType, (bool)e.Value, SelectedBbTypes)" />
										<label>
											<EnumDisplayName TEnum="BbType" Value="bbType" />
										</label>
									</div>
								}
							</div>

							<div>
								<span>Waga kulki (g):</span>
								<div>
									<input class="form-control" type="number" placeholder="Waga" @bind="BBWeight" />
								</div>
							</div>

							<div>
								<span>Rozmiar kulki (mm):</span>
								<div>
									<input class="form-control" type="number" placeholder="Rozmiar" @bind="BBSize" />
								</div>
							</div>

							break;
						}
					case AccessoryType.Gas:
						{
							<div>
								<span>Rodzaj gazu:</span>
								@foreach (GasType gType in Enum.GetValues(typeof(GasType)))
								{
									<div>
										<input class="form-check-input"
											   type="checkbox"
											   value="@gType"
											   checked="@SelectedGasTypes.Contains(gType)"
											   @onchange="(e) => ToggleType(gType, (bool)e.Value, SelectedGasTypes)" />
										<label>
											<EnumDisplayName TEnum="GasType" Value="gType" />
										</label>
									</div>
								}
							</div>

							break;
						}
					case AccessoryType.Battery:
						{
							<div>
								<span>Typ baterii:</span>
								@foreach (BatteryType batType in Enum.GetValues(typeof(BatteryType)))
								{
									<div>
										<input class="form-check-input"
											   type="checkbox"
											   value="@batType"
											   checked="@SelectedBatteryTypes.Contains(batType)"
											   @onchange="(e) => ToggleType(batType, (bool)e.Value, SelectedBatteryTypes)" />
										<label>
											<EnumDisplayName TEnum="BatteryType" Value="batType" />
										</label>
									</div>
								}
							</div>

							<div>
								<span>Wtyk baterii:</span>
								@foreach (BatteryPlug batPlug in Enum.GetValues(typeof(BatteryPlug)))
								{
									<div>
										<input class="form-check-input"
											   type="checkbox"
											   value="@batPlug"
											   checked="@SelectedBatteryPlugs.Contains(batPlug)"
											   @onchange="(e) => ToggleType(batPlug, (bool)e.Value, SelectedBatteryPlugs)" />
										<label>
											<EnumDisplayName TEnum="BatteryPlug" Value="batPlug" />
										</label>
									</div>
								}
							</div>

							<div>
								<span>Napięcie baterii:</span>
								@foreach (BatteryVoltage batVolt in Enum.GetValues(typeof(BatteryVoltage)))
								{
									<div>
										<input class="form-check-input"
											   type="checkbox"
											   value="@batVolt"
											   checked="@SelectedBatteryVoltages.Contains(batVolt)"
											   @onchange="(e) => ToggleType(batVolt, (bool)e.Value, SelectedBatteryVoltages)" />
										<label>
											<EnumDisplayName TEnum="BatteryVoltage" Value="batVolt" />
										</label>
									</div>
								}
							</div>

							break;
						}
					default:
						{
							Console.WriteLine("Invalid or null accessory type.");
							break;
						}
				}
			}
			else
			{
				Console.WriteLine("Invalid or null Category.");
			}

			break;
		}

	case nameof(Part):
		<p>Części</p>
		break;
	case nameof(Product):
		<p>Wszystkie</p>
		break;
}

<div class="d-flex flex-column gap-2">
	<button class="btn btn-secondary" @onclick="ApplyFilters">Zastosuj filtry</button>
	<button class="btn btn-danger" @onclick="ResetFilters">Resetuj filtry</button>
</div>

@code {
	[Parameter]
	public IEnumerable<T> ProductList { get; set; }

	[Parameter]
	public EventCallback<IEnumerable<T>> OnFilterChanged { get; set; }

	[Parameter]
	public string? Category { get; set; }

	private List<WeaponType> SelectedWeaponTypes { get; set; } = new List<WeaponType>();
	private List<GearboxType> SelectedGearboxTypes { get; set; } = new List<GearboxType>();
	private List<WeaponAge> SelectedWeaponAges { get; set; } = new List<WeaponAge>();
	private List<Manufacturer> SelectedManufacturers { get; set; } = new List<Manufacturer>();
	private List<BbType> SelectedBbTypes { get; set; } = new List<BbType>();
	private List<GasType> SelectedGasTypes { get; set; } = new List<GasType>();
	private List<BatteryType> SelectedBatteryTypes { get; set; } = new List<BatteryType>();
	private List<BatteryPlug> SelectedBatteryPlugs { get; set; } = new List<BatteryPlug>();
	private List<BatteryVoltage> SelectedBatteryVoltages { get; set; } = new List<BatteryVoltage>();

	private bool HasBatteryTrue { get; set; } = false;
	private bool HasBatteryFalse { get; set; } = false;
	private bool HasHopUpTrue { get; set; } = false;
	private bool HasHopUpFalse { get; set; } = false;
	private bool HasBlowBackTrue { get; set; } = false;
	private bool HasBlowBackFalse { get; set; } = false;

	private decimal MinPrice { get; set; }
	private decimal MaxPrice { get; set; }
	private decimal BBWeight { get; set; }
	private decimal BBSize { get; set; }

	private void ToggleType<TType>(TType type, bool isChecked, List<TType> selectedTypes)
	{
		if (isChecked)
		{
			if (!selectedTypes.Contains(type))
			{
				selectedTypes.Add(type);
			}
		}
		else
		{
			selectedTypes.Remove(type);
		}
	}

	private void ToggleBoolean(string type, bool isTrue, bool isChecked)
	{
		switch (type)
		{
			case "battery":
				if (isTrue)
				{
					HasBatteryTrue = isChecked;
				}
				else
				{
					HasBatteryFalse = isChecked;
				}
				break;
			case "hopUp":
				if (isTrue)
				{
					HasHopUpTrue = isChecked;
				}
				else
				{
					HasHopUpFalse = isChecked;
				}
				break;
			case "blowBack":
				if (isTrue)
				{
					HasBlowBackTrue = isChecked;
				}
				else
				{
					HasBlowBackFalse = isChecked;
				}
				break;
		}
	}

	private async Task ApplyFilters()
	{
		IEnumerable<T> filteredProducts = ProductList;

		switch (typeof(T).Name)
		{
			case nameof(Replica):
				{
					var replicas = filteredProducts.OfType<Replica>();

					if (!string.IsNullOrEmpty(Category))
					{
						replicas = replicas
							.Where(r => r.WeaponCategory.ToString().Equals(Category, StringComparison.OrdinalIgnoreCase));
					}

					if (SelectedWeaponTypes.Any())
					{
						replicas = replicas
							.Where(r => r.WeaponType.HasValue && SelectedWeaponTypes.Contains(r.WeaponType.Value));
					}

					if (SelectedGearboxTypes.Any())
					{
						replicas = replicas
							.Where(r => r.WeaponGearboxType.HasValue && SelectedGearboxTypes.Contains(r.WeaponGearboxType.Value));
					}

					if (SelectedWeaponAges.Any())
					{
						replicas = replicas.OfType<Replica>()
							.Where(r => SelectedWeaponAges.Contains(r.WeaponAge));
					}

					if (SelectedManufacturers.Any())
					{
						replicas = replicas.OfType<Replica>()
							.Where(r => r.Manufacturer.HasValue && SelectedManufacturers.Contains(r.Manufacturer.Value));
					}

					if (HasBatteryTrue && !HasBatteryFalse)
					{
						replicas = replicas.OfType<Replica>().Where(r => r.HasBattery == true);
					}
					else if (!HasBatteryTrue && HasBatteryFalse)
					{
						replicas = replicas.OfType<Replica>().Where(r => r.HasBattery == false);
					}

					if (HasHopUpTrue && !HasHopUpFalse)
					{
						replicas = replicas.OfType<Replica>().Where(r => r.HasHopUp == true);
					}
					else if (!HasHopUpTrue && HasHopUpFalse)
					{
						replicas = replicas.OfType<Replica>().Where(r => r.HasHopUp == false);
					}

					if (HasBlowBackTrue && !HasBlowBackFalse)
					{
						replicas = replicas.OfType<Replica>().Where(r => r.HasBlowBack == true);
					}
					else if (!HasBlowBackTrue && HasBlowBackFalse)
					{
						replicas = replicas.OfType<Replica>().Where(r => r.HasBlowBack == false);
					}

					if (MinPrice > 0 || MaxPrice > 0)
					{
						replicas = replicas.OfType<Replica>()
							.Where(r => r.Price >= MinPrice && r.Price <= MaxPrice);
					}

					filteredProducts = replicas.Cast<T>();

					break;
				}
			case nameof(Accessory):
				{
					var accessories = filteredProducts.OfType<Accessory>();

					if (!string.IsNullOrEmpty(Category))
					{
						accessories = accessories
							.Where(r => r.AccessoryType.ToString().Equals(Category, StringComparison.OrdinalIgnoreCase));
					}

					if (SelectedManufacturers.Any())
					{
						accessories = accessories.OfType<Accessory>()
							.Where(r => r.Manufacturer.HasValue && SelectedManufacturers.Contains(r.Manufacturer.Value));
					}

					if (SelectedBbTypes.Any())
					{
						accessories = accessories.OfType<Accessory>()
							.Where(r => r.BbType.HasValue && SelectedBbTypes.Contains(r.BbType.Value));
					}

					if (SelectedGasTypes.Any())
					{
						accessories = accessories.OfType<Accessory>()
							.Where(r => r.GasType.HasValue && SelectedGasTypes.Contains(r.GasType.Value));
					}

					if (SelectedBatteryTypes.Any())
					{
						accessories = accessories.OfType<Accessory>()
							.Where(r => r.BatteryType.HasValue && SelectedBatteryTypes.Contains(r.BatteryType.Value));
					}

					if (SelectedBatteryPlugs.Any())
					{
						accessories = accessories.OfType<Accessory>()
							.Where(r => r.BatteryPlug.HasValue && SelectedBatteryPlugs.Contains(r.BatteryPlug.Value));
					}

					if (SelectedBatteryVoltages.Any())
					{
						accessories = accessories.OfType<Accessory>()
							.Where(r => r.BatteryVoltage.HasValue && SelectedBatteryVoltages.Contains(r.BatteryVoltage.Value));
					}

					if (MinPrice > 0 || MaxPrice > 0)
					{
						accessories = accessories.OfType<Accessory>()
							.Where(r => r.Price >= MinPrice && r.Price <= MaxPrice);
					}

					if (BBSize > 0)
					{
						accessories = accessories.OfType<Accessory>()
							.Where(r => r.Bbsize == BBSize);
					}

					if (BBWeight > 0)
					{
						accessories = accessories.OfType<Accessory>()
							.Where(r => r.BbWeight == BBWeight);
					}

					filteredProducts = accessories.Cast<T>();

					break;
				}
		}

		await OnFilterChanged.InvokeAsync(filteredProducts);
	}

	private void ResetFilters()
	{
		switch (typeof(T).Name)
		{
			case nameof(Replica):
				{
					SelectedWeaponTypes.Clear();
					SelectedGearboxTypes.Clear();
					SelectedWeaponAges.Clear();

					HasBatteryTrue = false;
					HasBatteryFalse = false;
					HasHopUpTrue = false;
					HasHopUpFalse = false;
					HasBlowBackTrue = false;
					HasBlowBackFalse = false;

					break;
				}
			case nameof(Accessory):
				{
					SelectedBbTypes.Clear();
					SelectedGasTypes.Clear();
					SelectedBatteryTypes.Clear();
					SelectedBatteryPlugs.Clear();
					SelectedBatteryVoltages.Clear();

					BBSize = 0;
					BBWeight = 0;

					break;
				}
			case nameof(Part):
				{


					break;
				}
			case nameof(Equipment):
				{
					break;
				}
		}

		SelectedManufacturers.Clear();
		MinPrice = 0;
		MaxPrice = 0;

		ApplyFilters();
	}
}
