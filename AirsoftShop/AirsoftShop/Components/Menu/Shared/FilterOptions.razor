@using AirsoftShop.Components.Custom_Components
@using AirsoftShop.Data
@typeparam T

<div>
	@switch (typeof(T).Name)
	{
		case nameof(Replica):
			{
				<div>
					<p>Napęd broni:</p>
					@foreach (WeaponType wType in Enum.GetValues(typeof(WeaponType)))
					{
						<div>
							<input type="checkbox"
								   value="@wType"
								   @onchange="(e) => ToggleWeaponType(wType, (bool)e.Value)" />
							<label>
								<EnumDisplayName TEnum="WeaponType" Value="wType" />
							</label>
						</div>
					}
				</div>
				<button @onclick="ApplyFilters">Zastosuj filtry</button>
				break;
			}
		case nameof(Accessory):
			<p>Akcesoria</p>
			break;

		case nameof(Part):
			<p>Części</p>
			break;
	}
</div>

@code {
	[Parameter]
	public IEnumerable<T> FilterOption { get; set; }

	[Parameter]
	public EventCallback<IEnumerable<T>> OnFilterChanged { get; set; }

	private List<WeaponType> SelectedWeaponTypes { get; set; } = new List<WeaponType>();

	private void ToggleWeaponType(WeaponType weaponType, bool isChecked)
	{
		if (isChecked)
		{
			if (!SelectedWeaponTypes.Contains(weaponType))
			{
				SelectedWeaponTypes.Add(weaponType);
			}
		}
		else
		{
			SelectedWeaponTypes.Remove(weaponType);
		}
	}

	private async Task ApplyFilters()
	{
		IEnumerable<T> filtered = FilterOption;

		switch (typeof(T).Name)
		{
			case nameof(Replica):
				{
					if (SelectedWeaponTypes.Any())
					{
						filtered = FilterOption
							.OfType<Replica>()
							.Where(r => r.WeaponType.HasValue && SelectedWeaponTypes.Contains(r.WeaponType.Value))
							.Cast<T>();
					}
					else
					{
						filtered = FilterOption.OfType<Replica>().Cast<T>();
					}
					break;
				}
		}

		await OnFilterChanged.InvokeAsync(filtered);
	}
}
