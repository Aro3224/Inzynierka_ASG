@using AirsoftShop.Data

<div class="container-fluid d-flex flex-column px-5 gap-3">
	@switch (ProductList)
	{
		case List<Replica> replicaList:
			<FilterOptions T="Replica" ProductList="@replicaList" Category="@Category" OnFilterChanged="HandleFilterChanged" />
			break;
		case List<Part> partList:
			<FilterOptions T="Part" ProductList="@partList" Category="@Category" OnFilterChanged="HandleFilterChanged" />
			break;
		case List<Accessory> accessoryList:
			<FilterOptions T="Accessory" ProductList="@accessoryList" Category="@Category" OnFilterChanged="HandleFilterChanged" />
			break;
		case List<Product> allList:
			<FilterOptions T="Product" ProductList="@allList" Category="@Category" OnFilterChanged="HandleFilterChanged" />
			break;
		default:
			<p>Nieznany typ produktu.</p>
			break;
	}
</div>

@code {
	[Parameter]
	public IEnumerable<Product> ProductList { get; set; }

	[Parameter]
	public EventCallback<IEnumerable<Product>> OnFilterChanged { get; set; }

	[Parameter]
	public string? Category { get; set; }

	private async Task HandleFilterChanged(IEnumerable<Product> filteredProducts)
	{
		ProductList = filteredProducts;
		await OnFilterChanged.InvokeAsync(filteredProducts);
	}
}
