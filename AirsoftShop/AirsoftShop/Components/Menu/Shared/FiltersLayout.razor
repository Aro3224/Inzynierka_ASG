@using AirsoftShop.Data

<div class="container-fluid">
	@switch (ProductList)
	{
		case List<Replica> replicaList:
			<FilterOptions T="Replica" FilterOption="@replicaList" />
			break;
		case List<Part> partList:
			@switch (partList)
			{
				case var parts when parts.All(p => p.PartType == PartType.Internal):
					<FilterOptions T="Part" FilterOption="@partList" />
					break;
				case var parts when parts.All(p => p.PartType == PartType.External):
					<FilterOptions T="Part" FilterOption="@partList" />
					break;
				default:
					<FilterOptions T="Part" FilterOption="@partList" />
					break;
			}
			break;
		case List<Accessory> accessoryList:
			<FilterOptions T="Accessory" FilterOption="@accessoryList" />
			break;
		default:
			<p>Unexpected product type.</p>
			break;
	}
</div>

@code {
	[Parameter]
	public IEnumerable<Product> ProductList { get; set; }
}
