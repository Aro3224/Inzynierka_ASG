@using AirsoftShop.Data

@inject NavigationManager NavManager

<div class="col-md-3 product-card mb-2">
	<img src="@ImageSource" onerror="this.src='./Images/Replicas/icon01.png'" class="product-image cursor-pointer" @onclick="@(() => NavManager.NavigateTo($"Product/{Product.ProductType}/{Product.Id}"))">
	<div class="product-info">
		<div class="product-name">
			<h5 class="cursor-pointer hover-color" @onclick="@(() => NavManager.NavigateTo($"Product/{Product.ProductType}/{Product.Id}"))">@Product.Name</h5>
		</div>
		<p class="product-price">@Product.Price.ToString()zł</p>
		<button type="button" class="btn btn-primary">Do koszyka</button>
	</div>
</div>

@code {
	[Parameter]
	public string ImageSource { get; set; }

	[Parameter]
	public Product Product { get; set; }
}