@page "/Account/Manage/Repairs"
@using AirsoftShop.Components.Custom_Components
@rendermode InteractiveServer

@inject IPostWarrantyService PostWarrantyService
@inject IUserService UserService
@inject NavigationManager NavigationManager

<PageTitle>Serwis</PageTitle>

<div class="d-flex flex-row gap-3 mb-3">
	<h3>Serwis pogwarancyjny</h3>
	<button type="button" class="btn btn-outline-primary" @onclick='@(() => NavigationManager.NavigateTo("/Account/Manage/Repairs/Create"))'>Utwórz zgłoszenie</button>
</div>

@if (RequestsList is null)
{
	<p>Wczytywanie...</p>
}
else if (RequestsList.Count == 0)
{
	<p>Brak zgłoszeń serwisowych</p>
}
else
{
	<div class="container-fluid">
		<table class="table">
			<thead>
				<tr>
					<th scope="col"><strong>ID zgłoszenia</strong></th>
					<th scope="col"><strong>Status zgłoszenia</strong></th>
					<th scope="col"><strong>Data utworzenia</strong></th>
					<th scope="col"><strong>Szczegóły</strong></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var request in RequestsList)
				{
					<tr style="vertical-align: middle;">
						<td>@request.Id</td>
						<td><EnumDisplayName TEnum="ServiceStatus" Value="request.ServiceStatus" /></td>
						<td>@request.CreatedAt</td>
						<td>
							<button type="button" class="btn btn-outline-primary" @onclick='@(() => NavigationManager.NavigateTo($"/Account/Manage/Request/{request.Id}"))'>Zobacz</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
