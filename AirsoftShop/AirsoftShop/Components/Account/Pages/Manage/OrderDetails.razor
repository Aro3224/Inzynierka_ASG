@page "/Account/Manage/Orders/{OrderId:int}"
@using AirsoftShop.Components.Custom_Components
@using Microsoft.AspNetCore.Identity
@rendermode InteractiveServer

@inject IOrderService OrderService
@inject IProductService ProductService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavManager

<PageTitle>Szczegóły zamówienia @OrderId</PageTitle>

@if (!IsAuthorized)
{
	<div class="alert alert-danger">
		Nie masz dostępu do tego zamówienia.
	</div>
}
else if (Order is null)
{
	<p>Wczytywanie...</p>
}
else
{
	<div class="d-flex flex-column gap-3">
		<GoToPrevPage Page="Account/Manage/Orders" Text="Szczegóły zamówienia" />
		<h5>Numer zamówienia: @Order.Id</h5>
		<div>
			<h5>Status zamówienia: <EnumDisplayName TEnum="OrderStatus" Value="Order.OrderStatus" /></h5>
		</div>

		<div>
			<h5>Wpłata:</h5>

			<div class="d-flex flex-row align-items-center gap-2">
				<span><EnumDisplayName TEnum="PaymentMethod" Value="Order.PaymentMethod" /> - <EnumDisplayName TEnum="PaymentStatus" Value="Order.PaymentStatus" /></span>
				@if (Order.PaymentMethod != PaymentMethod.OnDelivery && Order.PaymentStatus == PaymentStatus.Pending)
				{
					<button type="button" class="btn btn-outline-primary" @onclick="PayForOrderAsync">Zapłać</button>
				}
			</div>
		</div>

		<div>
			<h4>Kurier: <EnumDisplayName TEnum="CourierCompany" Value="Order.CourierCompany" /></h4>
		</div>

		<div>
			<h4>Dane zamawiającego</h4>

			<span><strong>@Order.CustomerName @Order.CustomerSurname</strong></span>
			<br />
			<span><strong>Adres: </strong>@Order.ShippingAddress</span>
		</div>

		<div>
			<h4>Zamówione produkty</h4>

			<table class="table">
				<thead>
					<tr>
						<th scope="col">Nazwa produktu</th>
						<th scope="col">Kod produktu</th>
						<th scope="col">Ilość</th>
						<th scope="col">Wartość</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Order.OrderItems)
					{
						<tr style="vertical-align: middle;">
							@if (item.ReplicaId is not null)
							{
								<td>
									<a href="/Product/Replica/@item.ReplicaId" class="text-decoration-none">@item.Replica.Name</a>
								</td>
								<td>@item.Replica.ProductId</td>
								<td>@item.Quantity</td>
								<td>@item.Price PLN</td>
							}
							else if (item.PartId is not null)
							{
								<td>
									<a href="/Product/Part/@item.PartId" class="text-decoration-none">@item.Part.Name</a>
								</td>
								<td>@item.Part.ProductId</td>
								<td>@item.Quantity</td>
								<td>@item.Price PLN</td>
							}
							else if (item.AccessoryId is not null)
							{
								<td>
									<a href="/Product/Accessory/@item.AccessoryId" class="text-decoration-none">@item.Accessory.Name</a>
								</td>
								<td>@item.Accessory.ProductId</td>
								<td>@item.Quantity</td>
								<td>@item.Price PLN</td>
							}
						</tr>
					}
				</tbody>
			</table>
		</div>

		<div class="row">
			<div class="col-md-8"></div>
			<div class="col-md-4 d-flex justify-content-between">
				<span>Wartość zamówienia</span>

				<span><strong>@Order.TotalAmount PLN</strong></span>
			</div>
		</div>

		@if (Order.OrderStatus == OrderStatus.Completed)
		{
			<div class="row">
				<h4>Dodatkowe opcje</h4>
				<div class="col-md-3">
					<div class="d-flex flex-column gap-2">
						@if (IsReturnAllowed())
						{
							<button type="button" class="btn btn-outline-secondary">Zwrot towaru</button>
						}
						<button type="button" class="btn btn-outline-primary" @onclick="@(() => NavManager.NavigateTo($"/Account/Manage/Complaint/{Order.Id}"))">Reklamacja</button>
					</div>
				</div>
			</div>
		}
	</div>
}
