@page "/Account/Manage/Complaint/{OrderId:int}"
@using AirsoftShop.Components.Custom_Components
@using Microsoft.AspNetCore.Identity
@rendermode InteractiveServer

@inject IOrderService OrderService
@inject IComplaintService ComplaintService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavManager

<PageTitle>Nowa reklamacja</PageTitle>

<GoToPrevPage Page="Account/Manage/Orders" Text="Reklamacja zamówienia" Id="@OrderId.ToString()" />

@if (!IsAuthorized)
{
	<div class="alert alert-danger">
		Nie masz dostępu do tego zamówienia.
	</div>
}
else if (Order is null || complaint is null)
{
	<p>Wczytywanie...</p>
}
else
{
	<table class="table">
		<thead>
			<tr>
				<th scope="col">Nazwa produktu</th>
				<th scope="col">Gwarancja (miesiące)</th>
				<th scope="col">Zamówiona ilość</th>
				<th scope="col">Wartość</th>
				<th scope="col">Reklamacja</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Order.OrderItems)
			{
				<tr style="vertical-align: middle;">
					@if (item.ReplicaId is not null)
					{
						<td>
							<a href="/Product/Replica/@item.ReplicaId" class="text-decoration-none">@item.Replica.Name</a>
						</td>
						<td>@item.Replica.WarrantyPeriodMonths</td>
					}
					else if (item.PartId is not null)
					{
						<td>
							<a href="/Product/Part/@item.PartId" class="text-decoration-none">@item.Part.Name</a>
						</td>
						<td>@item.Part.WarrantyPeriodMonths</td>
					}
					else if (item.AccessoryId is not null)
					{
						<td>
							<a href="/Product/Accessory/@item.AccessoryId" class="text-decoration-none">@item.Accessory.Name</a>
						</td>
						<td>@item.Accessory.WarrantyPeriodMonths</td>
					}

					<td>@item.Quantity</td>
					<td>@item.Price PLN</td>
					<td>
						<input type="checkbox" @onchange="(e) => ToggleItemSelection(e, item)" />
					</td>
				</tr>
			}
		</tbody>
	</table>

	<EditForm Model="@complaint" OnValidSubmit="SubmitComplaint" class="d-flex flex-column gap-3">

		<div class="form-group">
			<label for="complaintDescription">Opis usterki:</label>
			<InputTextArea id="complaintDescription" class="form-control" @bind-Value="complaint.ComplaintDescription" />
			<ValidationMessage For="@(() => complaint.ComplaintDescription)" />
		</div>

		<div>
			<label for="complaintChoice">Oczekiwania wobec reklamacji:</label>
			<InputSelect id="complaintChoice" @bind-Value="complaint.CustomerComplaintChoice" class="form-select">
				@foreach (var complaintChoice in Enum.GetValues<CustomerComplaintChoice>())
				{
					<option value="@complaintChoice"><EnumDisplayName TEnum="CustomerComplaintChoice" Value="complaintChoice" /></option>
				}
			</InputSelect>
			<ValidationMessage For="@(() => complaint.CustomerComplaintChoice)" />
		</div>

		<div>
			<button type="submit" class="btn btn-outline-primary">Złóż reklamację</button>
		</div>

	</EditForm>
}