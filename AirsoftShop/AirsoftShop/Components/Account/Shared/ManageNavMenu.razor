@using Microsoft.AspNetCore.Identity
@using AirsoftShop.Data

@inject SignInManager<ApplicationUser> SignInManager

<ul class="nav nav-pills flex-column">
    <li class="nav-item">
        <NavLink class="nav-link" href="Account/Manage" Match="NavLinkMatch.All">Twój profil</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="Account/Manage/Email">Email</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="Account/Manage/ChangePassword">Hasło</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="#">Zamówienia</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="#">Reklamacje</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link" href="#">Serwis</NavLink>
    </li>
    <li class="nav-item">
        <NavLink class="nav-link link-danger" href="/Account/Manage/DeletePersonalData">Usuń konto</NavLink>
    </li>
</ul>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
