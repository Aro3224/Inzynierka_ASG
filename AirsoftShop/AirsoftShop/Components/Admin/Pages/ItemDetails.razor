@page "/Admin/ProductDetails/{ProductType}/{Id}"
@using AirsoftShop.Data
@using System.ComponentModel.DataAnnotations

@inject NavigationManager NavManager
@inject IProductService ProductService

@attribute [Authorize(Roles = "Admin")]

<PageTitle>Szczegóły przedmiotu</PageTitle>
<GoToPrevPage Page="Admin/ItemManage" Text="Szczegóły przedmiotu" />

@if (Product is not null)
{
	<div class="custom-container mt-5">
		<div class="py-2">

            @foreach (var property in Product.GetType().GetProperties())
            {
                var value = property.GetValue(Product);

                var displayName = property.GetCustomAttributes(typeof(DisplayAttribute), false)
                .Cast<DisplayAttribute>()
                .FirstOrDefault()?.Name ?? property.Name;

                if (value is not null && property.Name != nameof(Product.Id))
                {
                    if (value.GetType().IsEnum)
                    {
                        if (value.GetType().GetCustomAttributes(typeof(FlagsAttribute), false).Any())
                        {
                            var flags = Enum.GetValues(value.GetType())
                            .Cast<Enum>()
                            .Where(flag => ((Enum)value).HasFlag(flag) && Convert.ToInt32(flag) != 0)
                            .Select(flag => flag.GetType()
                            .GetField(flag.ToString())
                            ?.GetCustomAttributes(typeof(DisplayAttribute), false)
                            .Cast<DisplayAttribute>()
                            .FirstOrDefault()?.Name ?? flag.ToString());

                            value = string.Join(", ", flags);
                        }
                        else
                        {
                            value = value.GetType()
                            .GetField(value.ToString())
                            ?.GetCustomAttributes(typeof(DisplayAttribute), false)
                            .Cast<DisplayAttribute>()
                            .FirstOrDefault()?.Name ?? value.ToString();
                        }
                    }
                    else if (value is bool boolValue)
                    {
                        value = boolValue ? "Tak" : "Nie";
                    }

                    <div>
                        <span><b>@displayName:</b></span>
                        <span>@value</span>
                    </div>
                }
            }



			<div class="container-fluid">
				<button class="btn btn-secondary" @onclick="@(() => NavManager.NavigateTo($"/Admin/ProductDetails/Edit/{Id}"))">Edytuj</button>
				<button class="btn btn-danger" @onclick="@(() => Delete(Id))">Usuń</button>
			</div>
		</div>
	</div>
}
else
{
	<p>Wczytywanie...</p>
}
