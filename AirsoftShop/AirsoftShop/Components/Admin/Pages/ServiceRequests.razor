@page "/Admin/ServiceRequests"

@inject IPostWarrantyService PostWarrantyService
@inject IUserService UserService
@inject NavigationManager NavigationManager

@attribute [Authorize(Roles = "Admin")]

<PageTitle>Serwis</PageTitle>

<h2>Zgłoszenia serwisowe</h2>

@if (RequestsList is null)
{
	<p>Wczytywanie...</p>
}
else if (RequestsList.Count == 0)
{
	<p>Nie ma żadnych zgłoszeń</p>
}
else
{
	<div class="container-fluid">
		<table class="table">
			<thead>
				<tr>
					<th scope="col"><strong>ID zgłoszenia</strong></th>
					<th scope="col"><strong>Zgłaszający</strong></th>
					<th scope="col"><strong>Status zgłoszenia</strong></th>
					<th scope="col"><strong>Data utworzenia</strong></th>
					<th scope="col"><strong>Szczegóły</strong></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var request in RequestsList)
				{
					<tr style="vertical-align: middle;">
						<td>@request.Id</td>
						<td>@(UserEmails.ContainsKey(request.UserId) ? UserEmails[request.UserId] : "Nieznany użytkownik")</td>
						<td><EnumDisplayName TEnum="ServiceStatus" Value="request.ServiceStatus" /></td>
						<td>@request.CreatedAt</td>
						<td>
							<button type="button" class="btn btn-outline-primary" @onclick='@(() => NavigationManager.NavigateTo($"/Admin/Request/{request.Id}"))'>Zobacz</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
